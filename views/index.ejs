                  stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <polyline points="15 3 21 3 21 9" />
                  <line x1="10" x2="14" y1="14" y2="10" />
                </svg>
              </a>
            </div>

          </div>
        </div>

        <!-- Section 4 : Protocole d'évaluation rapide -->
        <div class="bg-gradient-to-br from-[#191e2b] to-[#151722] border border-sky-500/25 rounded-xl p-4">
          <h3 class="text-xs font-semibold text-sky-300 mb-2 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-sky-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round">
              <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" />
            </svg>
            Comment tester la démo en 2 minutes chrono ?
          </h3>

          <ol class="space-y-2 text-[11px] text-slate-300">
            <li class="flex items-start gap-2">
              <span
                class="w-4 h-4 rounded-full bg-sky-500/20 text-sky-300 text-[10px] font-bold flex items-center justify-center shrink-0 mt-0.5">1</span>
              <span>Cliquez sur <strong>« Exemple démo »</strong> : chaque clic génère une longue note brute réaliste
                tirée au sort parmi nos 3 clients (Ravinala, Ambatolampy, FOI).</span>
            </li>
            <li class="flex items-start gap-2">
              <span
                class="w-4 h-4 rounded-full bg-sky-500/20 text-sky-300 text-[10px] font-bold flex items-center justify-center shrink-0 mt-0.5">2</span>
              <span>Cliquez sur <strong>« Créer la fiche Notion »</strong> pour lancer l'analyse IA.</span>
            </li>
            <li class="flex items-start gap-2">
              <span
                class="w-4 h-4 rounded-full bg-sky-500/20 text-sky-300 text-[10px] font-bold flex items-center justify-center shrink-0 mt-0.5">3</span>
              <span>Observez les livrables générés : téléchargez le Word, ouvrez le Google Docs collaboratif, et cliquez
                sur <strong>« Fiche Notion »</strong> pour voir la réunion ajoutée et liée au client dans le CRM.</span>
            </li>
          </ol>
        </div>

        <!-- Section 5 : Environnement sandbox et sécurité -->
        <div
          class="flex items-start gap-2.5 p-3 rounded-lg bg-amber-500/[0.07] border border-amber-500/20 text-[11px] text-amber-200/90">
          <svg class="w-4 h-4 text-amber-400 shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
