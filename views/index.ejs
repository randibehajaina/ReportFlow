      class="relative w-full max-w-2xl bg-[#15171f] border border-[#2b3040] rounded-2xl shadow-[0_20px_60px_rgba(0,0,0,0.7)] overflow-hidden my-auto transition-all">
      <!-- En-tête modal -->
      <div
        class="px-5 py-4 border-b border-[#232736] flex items-center justify-between bg-gradient-to-r from-[#191c26] to-[#15171f]">
        <div class="flex items-center space-x-2.5">
          <div
            class="w-8 h-8 rounded-xl bg-sky-500/10 border border-sky-500/25 flex items-center justify-center text-sky-400 shadow-inner">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <path d="M12 16v-4" />
              <path d="M12 8h.01" />
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h2 id="modal-guide-title" class="text-sm sm:text-base font-heading font-bold text-slate-100">
                Guide Démonstration & Contexte Métier
              </h2>
            </div>
            <p class="text-[11px] text-slate-400">Comprendre le fonctionnement et observer les résultats en temps réel
            </p>
          </div>
        </div>

        <button type="button" id="btn-close-guide-modal"
          class="text-slate-400 hover:text-slate-200 p-1.5 rounded-lg hover:bg-white/5 transition-colors cursor-pointer"
