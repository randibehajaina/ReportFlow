<!DOCTYPE html>
<html lang="fr" class="h-full bg-[#131418] text-slate-200 antialiased selection:bg-slate-700 selection:text-white">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/ReportFlow-icon.svg">
  <title>ReportFlow — Notes, Documents & Synthèses Notion</title>

  <!-- Typographies Google Fonts (Plus Jakarta Sans & Inter) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap"
    rel="stylesheet">

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Bibliothèque d'icônes Lucide -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
            heading: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
          },
          colors: {
            calm: {
              bg: '#131418',
              card: '#1a1c23',
              border: '#272a34',
              hover: '#22252f',
              muted: '#8b92a3',
            }
          }
        }
      }
    }
  </script>

  <style>
    * {
      -webkit-font-smoothing: antialiased;
    }

    .calm-card {
      background-color: #1a1c23;
      border: 1px solid #272a34;
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.25);
    }

    @keyframes smoothFadeIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-calm {
      animation: smoothFadeIn 0.3s ease-out forwards;
    }

    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }

    ::-webkit-scrollbar-thumb {
      background: #2e323e;
      border-radius: 9999px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #3d4253;
    }

    .action-checkbox:checked+span {
      text-decoration: line-through;
      color: #64748b;
    }
  </style>
</head>

<body class="min-h-full flex flex-col font-sans bg-[#131418] text-slate-200">

  <!-- En-tête de navigation -->
  <header class="border-b border-[#232630] bg-[#16181e]/90 sticky top-0 z-20 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">

      <!-- Logo ReportFlow -->
      <div class="flex items-center space-x-3">
        <div
          class="w-8 h-8 rounded-lg bg-[#242833] border border-[#313645] flex items-center justify-center text-slate-100 font-heading font-semibold text-xs shadow-inner">
          RF
        </div>
        <div>
          <span class="font-heading font-bold text-sm text-slate-100">ReportFlow</span>
          <span class="text-slate-600 mx-1.5">•</span>
          <span class="text-xs text-slate-400">Carnet de réunion</span>
        </div>
      </div>

      <!-- Liens d'accès Cloud (Drive & Notion) -->
      <div class="flex items-center space-x-2 sm:space-x-2.5">

        <!-- Bouton d'ouverture du guide de démonstration -->
        <button type="button" id="btn-open-guide-header"
          class="group flex items-center space-x-1.5 text-xs bg-gradient-to-r from-sky-500/10 hover:from-sky-500/20 to-indigo-500/10 hover:to-indigo-500/20 border border-sky-500/30 hover:border-sky-400/50 text-sky-200 hover:text-white px-2.5 sm:px-3 py-1.5 rounded-full transition-all duration-200 shadow-sm cursor-pointer"
          title="Guide du test et fonctionnement de la démo">
          <svg class="w-3.5 h-3.5 text-sky-400 group-hover:scale-110 transition-transform"
            xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 16v-4" />
            <path d="M12 8h.01" />
          </svg>
          <span class="font-medium hidden sm:inline">Guide Démo</span>
          <span class="font-medium sm:hidden">Guide</span>
        </button>

        <!-- Accès Google Drive -->
        <a href="<%= locals.driveUrl || 'https://drive.google.com/drive/folders/1E0JuMIXHv3cTl3GsP-Tl5ilqp5C1iX7Z?usp=drive_link' %>"
          target="_blank" rel="noopener noreferrer"
          class="group flex items-center space-x-2 text-xs bg-[#191b22] hover:bg-[#20232d] border border-[#262933] hover:border-[#383d4c] px-3 py-1.5 rounded-full transition-all duration-200 shadow-sm"
          title="Ouvrir le dossier des comptes-rendus dans Google Drive">
          <!-- Icône Google Drive -->
          <svg class="w-3.5 h-3.5 shrink-0 transition-transform duration-200 group-hover:scale-110"
            viewBox="0 0 87.3 78" xmlns="http://www.w3.org/2000/svg">
            <path d="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z"
              fill="#0066da" />
            <path d="m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44c-.8 1.4-1.2 2.95-1.2 4.5h27.5z"
              fill="#00ac47" />
            <path
              d="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.502l5.852 11.5z"
              fill="#ea4335" />
            <path d="m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z" fill="#00832d" />
            <path d="m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z" fill="#2684fc" />
            <path d="m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3l-13.75 23.8 16.15 28h27.45c0-1.55-.4-3.1-1.2-4.5z"
              fill="#ffba00" />
          </svg>
          <span
            class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.7)] animate-pulse"></span>
          <span class="text-[12px] font-medium text-slate-300 group-hover:text-white transition-colors">Google
            Drive</span>
          <svg class="w-3 h-3 text-slate-500 group-hover:text-slate-300 transition-colors hidden sm:block"
            xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" x2="14" y1="14" y2="10" />
          </svg>
        </a>

        <!-- Accès Notion -->
        <a href="<%= locals.notionUrl || 'https://app.notion.com/p/Accueil-4026955c3b6480b097e9fdc8171e8edf?pvs=12' %>"
          target="_blank" rel="noopener noreferrer"
          class="group flex items-center space-x-2 text-xs bg-[#191b22] hover:bg-[#20232d] border border-[#262933] hover:border-[#383d4c] px-3 py-1.5 rounded-full transition-all duration-200 shadow-sm"
          title="Ouvrir l'accueil Notion">
          <!-- Icône Notion -->
          <svg class="w-3.5 h-3.5 shrink-0 transition-transform duration-200 group-hover:scale-110"
            viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path
              d="M6.015 13.513c3.424 2.71 4.544 2.56 10.822 2.128l58.987-4.256c2.428-.148 3.14-.852 2.28-2.71L73.978 2.378C72.552.41 70.418 0 67.57 0L10.005 3.968C6.301 4.248 5.161 5.39 5.73 7.828l.285 5.685z"
              fill="#ffffff" />
            <path fill-rule="evenodd" clip-rule="evenodd"
              d="M13.435 25.105v62.463c0 4.148 2.14 5.86 6.85 5.568l62.98-3.708c4.71-.282 5.28-3.284 5.28-6.998V20.106c0-3.714-1.57-5.286-4.99-4.998L18.425 18.96c-3.71.282-4.99 2.428-4.99 6.145zm58.557 3.568c.285 1.285-.43 2.57-1.854 2.71l-3.57.574v43.275c-2.14 1.144-4.566 1.855-6.85 1.855-3.71 0-5.14-1.285-7.994-4.714L34.56 42.667v26.99l5.14 1.143c1.425.286 1.854 1.57 1.425 2.856-.43 1.286-1.57 1.57-3.71 1.713l-11.42 1.002c-1.43.143-2.14-.716-1.712-2.144.285-1.286 1.14-2.144 2.567-2.429l3.996-.572V34.526l-4.71-.43c-1.427-.143-2-1.286-1.57-2.57.428-1.286 1.57-1.572 3.71-1.715l13.13-1.143 18.27 28.277V32.955l-4.28-.572c-1.427-.143-1.855-1.429-1.427-2.714.43-1.286 1.57-1.572 3.71-1.715l11.42-.714c1.712-.143 2.14.714 2.568 2.428z"
              fill="#ffffff" />
          </svg>
          <span
            class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.7)] animate-pulse"></span>
          <span class="text-[12px] font-medium text-slate-300 group-hover:text-white transition-colors">Notion</span>
          <svg class="w-3 h-3 text-slate-500 group-hover:text-slate-300 transition-colors hidden sm:block"
            xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" x2="14" y1="14" y2="10" />
          </svg>
        </a>

      </div>

    </div>
  </header>

  <!-- Contenu principal -->
  <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-8">

    <!-- Titre et synthèse d'introduction -->
    <div class="text-center max-w-2xl mx-auto mb-8">
      <h1 class="text-xl sm:text-2xl font-heading font-bold text-slate-100 tracking-tight">
        Rédigez vos notes, obtenez un résumé clair
      </h1>
      <p class="text-sm text-slate-400 mt-1.5 leading-relaxed">
        Collez vos notes ou déposez un audio. Nous extrayons le client, générons un rapport Word officiel et
        synchronisons la fiche en direct dans Notion et Google Drive.
      </p>

      <!-- Workflow en 3 étapes -->
      <div
        class="mt-5 inline-flex items-center justify-center gap-2 sm:gap-4 py-2 px-4 rounded-xl bg-[#191b22] border border-[#262933] text-xs text-slate-400 shadow-sm">

        <!-- Étape 1 : Saisie -->
        <span class="flex items-center gap-1.5 text-slate-300 font-medium">
          <svg class="w-3.5 h-3.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
          </svg>
          Notes & Audio
        </span>

        <svg class="w-3.5 h-3.5 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>

        <!-- Étape 2 : Traitement IA -->
        <span class="flex items-center gap-1.5 text-slate-300 font-medium">
          <svg class="w-3.5 h-3.5 text-sky-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <path
              d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
          </svg>
          Synthèse IA
        </span>

        <svg class="w-3.5 h-3.5 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>

        <!-- Étape 3 : Synchronisation -->
        <span class="flex items-center gap-1.5 text-emerald-400 font-medium">
          <svg class="w-3.5 h-3.5 text-emerald-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <path d="m9 11 3 3L22 4" />
          </svg>
          Synchro Notion & Drive
        </span>

      </div>
    </div>

    <!-- Avertissement d'environnement de test -->
    <aside id="demo-privacy-notice"
      class="mb-6 rounded-2xl bg-gradient-to-r from-amber-500/[0.08] via-[#1a1c24] to-amber-500/[0.04] border border-amber-500/25 p-3.5 sm:p-4 shadow-sm backdrop-blur-sm transition-all duration-300"
      aria-label="Avertissement de confidentialité">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-start space-x-3 min-w-0">
          <!-- Icône d'avertissement -->
          <div
            class="w-8 h-8 rounded-xl bg-amber-500/10 border border-amber-500/25 flex items-center justify-center shrink-0 text-amber-400 mt-0.5 shadow-inner">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              <line x1="12" y1="8" x2="12" y2="12" />
              <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
          </div>

          <div class="text-xs leading-relaxed text-slate-300">
            <span class="font-semibold text-amber-300 mr-1">
              Démo Live & Bac à sable :
            </span>
            Cette application est connectée en temps réel à un CRM Notion et un Google Drive de test. Les données
            saisies sont publiques : n’importez aucune donnée réelle.
            <button type="button" id="btn-open-guide-notice"
              class="ml-1 inline-flex items-center gap-1 font-semibold text-amber-300 hover:text-white underline decoration-amber-400/50 hover:decoration-white underline-offset-2 transition-colors cursor-pointer">
              <span>Comment tester & comprendre les coulisses Cloud ?</span>
              <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Bouton de masquage de la notice -->
        <button type="button" id="btn-dismiss-privacy"
          class="text-slate-400 hover:text-slate-200 p-1 rounded-lg hover:bg-white/5 transition-colors shrink-0 cursor-pointer"
          title="Masquer cet avertissement" aria-label="Fermer la notice">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </aside>

    <!-- Grille principale de travail -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      <!-- Colonne gauche : Saisie et téléversement -->
      <section class="lg:col-span-6 space-y-3">

        <div class="calm-card rounded-2xl overflow-hidden">

          <!-- Barre d'outils de l'éditeur -->
          <div class="flex items-center justify-between px-5 py-3 border-b border-[#252834] bg-[#16181f]/60">
            <span class="text-xs font-semibold text-slate-300">Vos notes brutes</span>

            <!-- Actions d'édition -->
            <div class="flex items-center space-x-1.5 text-xs">

              <!-- Bouton Exemple -->
              <button type="button" id="btn-exemple"
                class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-lg text-slate-300 hover:text-white bg-[#222530] hover:bg-[#2b2e3c] border border-[#2e3240] transition-colors"
                title="Insérer un exemple de test">
                <svg class="w-3.5 h-3.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                  <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                  <path d="M10 9H8" />
                  <path d="M16 13H8" />
                  <path d="M16 17H8" />
                </svg>
                <span>Exemple</span>
              </button>

              <!-- Bouton Coller -->
              <button type="button" id="btn-paste"
                class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-lg text-slate-300 hover:text-white bg-[#222530] hover:bg-[#2b2e3c] border border-[#2e3240] transition-colors"
                title="Coller le texte de votre presse-papier">
                <svg class="w-3.5 h-3.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round">
                  <rect width="8" height="4" x="8" y="2" rx="1" ry="1" />
                  <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                  <path d="M12 11h4" />
                  <path d="M12 16h4" />
                  <path d="M8 11h.01" />
                  <path d="M8 16h.01" />
                </svg>
                <span>Coller</span>
              </button>

              <!-- Bouton Effacer -->
              <button type="button" id="btn-clear"
                class="inline-flex items-center space-x-1 px-2 py-1 rounded text-slate-400 hover:text-slate-200 transition-colors"
                title="Vider la zone de texte">
                <svg class="w-3.5 h-3.5 text-slate-500 hover:text-slate-300" xmlns="http://www.w3.org/2000/svg"
                  width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 6h18" />
                  <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                  <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                  <line x1="10" x2="10" y1="11" y2="17" />
                  <line x1="14" x2="14" y1="11" y2="17" />
                </svg>
                <span>Effacer</span>
              </button>

            </div>
          </div>

          <!-- Formulaire de saisie et upload -->
          <form id="form-analyse" class="p-5 space-y-4">

            <!-- Alerte visuelle : Verrouillage du texte quand un fichier est joint -->
            <div id="banner-fichier-actif"
              class="hidden p-3 rounded-xl bg-sky-950/40 border border-sky-800/50 text-xs text-sky-200 flex items-center justify-between gap-3 animate-calm">
              <div class="flex items-center space-x-2.5 min-w-0">
                <div class="w-6 h-6 rounded-lg bg-sky-500/20 text-sky-300 flex items-center justify-center shrink-0">
                  <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                  </svg>
                </div>
                <div class="min-w-0">
                  <p class="font-medium text-slate-100">Mode Document / Audio actif</p>
                  <p class="text-[11px] text-sky-300/80 truncate">La saisie de texte est verrouillée pour garantir que
                    seul ce fichier soit traité.</p>
                </div>
              </div>
              <button type="button" id="btn-unlock-text"
                class="text-[11px] font-semibold text-sky-300 hover:text-white underline decoration-sky-400/40 hover:decoration-white transition-colors shrink-0 cursor-pointer">
                Retirer le fichier
              </button>
            </div>

            <textarea id="notes-brutes" rows="10"
              placeholder="Collez ou écrivez vos notes ici (ou déposez directement un document ci-dessous)...&#10;&#10;Exemple :&#10;Date de la réunion : 08/01/2026&#10;Client : Fonds Océan Indien Demo&#10;Point d'avancement sur l'étude d'impact environnemental..."
              class="w-full bg-transparent border-0 p-0 text-slate-100 placeholder-slate-500 focus:ring-0 focus:outline-none text-sm leading-relaxed resize-y font-sans transition-opacity"></textarea>

            <!-- Zone de téléversement (Documents et Audio) -->
            <div class="space-y-2">
              <input type="file" id="input-fichier" accept=".pdf,.docx,.txt,.mp3,.m4a,.wav,.ogg,.aac,.webm,.flac"
                class="hidden">

              <!-- Notice de verrouillage quand du texte est saisi -->
              <div id="dropzone-locked-notice"
                class="hidden p-3 rounded-xl bg-[#16181f]/80 border border-amber-500/30 text-xs text-amber-200/90 flex items-center justify-between gap-3 animate-calm">
                <div class="flex items-center space-x-2.5 min-w-0">
                  <div
