            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Contenu modal -->
      <div class="p-5 sm:p-6 space-y-4 max-h-[72vh] overflow-y-auto text-xs text-slate-300 leading-relaxed">

        <!-- Section 1 : Périmètre fonctionnel et cas d'usage -->
        <div class="bg-[#1a1c27] border border-[#262a3a] rounded-xl p-4">
          <div class="flex items-center gap-2 text-slate-100 font-semibold text-xs mb-1.5">
            <svg class="w-4 h-4 text-sky-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
              <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
            <span>Pour qui et quel problème est résolu ?</span>
          </div>
          <p class="text-slate-300 text-[12px] leading-relaxed">
            Conçu pour les <strong>consultants, chefs de projet et commerciaux B2B</strong> qui perdent 30 à 45 minutes
            après chaque réunion à réécouter des enregistrements, rédiger des comptes-rendus et renseigner leur CRM.
          </p>
          <p class="text-slate-400 text-[11px] mt-1.5">
            ReportFlow convertit cette friction en une opération instantanée : vous déposez des notes brutes ou un
            enregistrement audio, l’IA extrait les points clés, produit un livrable Word officiel et synchronise
            automatiquement le tout dans Notion et Google Drive.
          </p>
        </div>

        <!-- Section 2 : Entités clientes et relations CRM -->
        <div class="bg-gradient-to-br from-[#1e2333] to-[#171a25] border border-sky-500/30 rounded-xl p-4 shadow-sm">
          <div class="flex items-center gap-2 text-sky-300 font-semibold text-xs mb-2">
            <svg class="w-4 h-4 text-sky-400 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <polyline points="14 2 14 8 20 8" />
              <line x1="16" y1="13" x2="8" y2="13" />
              <line x1="16" y1="17" x2="8" y2="17" />
              <polyline points="10 9 9 9 8 9" />
            </svg>
            <span>Rédigez vos propres notes (Liaison CRM automatique)</span>
          </div>
          <p class="text-slate-300 text-[11.5px] leading-relaxed mb-2.5">
            Vous pouvez tester l'outil en écrivant vous-même vos propres notes brutes. Pour observer la <strong>liaison
              automatique en direct</strong>, intégrez simplement dans votre texte l’un des 3 clients déjà présents dans
            notre CRM Notion :
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 mb-2.5">
            <div class="bg-[#12141c]/90 border border-[#2b3044] rounded-lg p-2.5 text-center">
              <span class="block font-semibold text-slate-100 text-[11px]">Fonds Océan Indien Demo</span>
              <span class="text-[10px] text-sky-400">Finance & Investissement</span>
            </div>
            <div class="bg-[#12141c]/90 border border-[#2b3044] rounded-lg p-2.5 text-center">
              <span class="block font-semibold text-slate-100 text-[11px]">Commune d’Ambatolampy Demo</span>
              <span class="text-[10px] text-emerald-400">Collectivité & Travaux</span>
            </div>
            <div class="bg-[#12141c]/90 border border-[#2b3044] rounded-lg p-2.5 text-center">
              <span class="block font-semibold text-slate-100 text-[11px]">Ravinala Logistique Demo</span>
              <span class="text-[10px] text-indigo-400">Fret & Logistique aéroport</span>
            </div>
          </div>

          <p class="text-slate-400 text-[11px] leading-relaxed">
            Dès que l'IA détecte l'un de ces noms (même écrit au milieu d'un paragraphe désordonné), le compte-rendu est
            automatiquement relié à la fiche du client dans la colonne <code
              class="text-sky-300 text-[10px]">Rapports</code> de Notion, sans jamais écraser ses réunions antérieures.
          </p>
        </div>

        <!-- Section 3 : Intégrations Notion et Google Drive -->
        <div>
          <div
            class="text-[11px] font-semibold text-slate-200 uppercase tracking-wider mb-2.5 flex items-center justify-between">
