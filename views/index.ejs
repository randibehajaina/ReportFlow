                  <span class="text-[10px] text-sky-400 font-mono">Relation 1-à-N</span>
                </div>
                <p class="text-[11px] text-slate-400 leading-normal">
                  Chaque réunion génère une ligne propre dans la table des rapports et vient s'ajouter à l'historique
                  complet du client concerné dans la table CRM.
                </p>
              </div>
              <a href="<%= locals.notionUrl || 'https://app.notion.com/p/Accueil-4026955c3b6480b097e9fdc8171e8edf?pvs=12' %>"
                target="_blank" rel="noopener noreferrer"
                class="mt-3 inline-flex items-center justify-between text-[11px] font-medium text-slate-300 hover:text-white bg-[#20232e] hover:bg-[#282d3b] px-2.5 py-1.5 rounded-lg border border-[#2f3445] transition-colors">
                <span>Ouvrir l'accueil Notion</span>
                <svg class="w-3 h-3 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round">
