<!DOCTYPE html>
<html lang="fr" class="h-full bg-[#131418] text-slate-200 antialiased selection:bg-slate-700 selection:text-white">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ReportFlow — Notes, Documents & Synthèses Notion</title>
  
  <!-- Polices Google : Plus Jakarta Sans (titres doux) & Inter (confort de lecture) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Bibliothèque d'icônes Lucide -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
            heading: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
          },
          colors: {
            calm: {
              bg: '#131418',
              card: '#1a1c23',
              border: '#272a34',
              hover: '#22252f',
              muted: '#8b92a3',
            }
          }
        }
      }
    }
  </script>

  <style>
    * {
      -webkit-font-smoothing: antialiased;
    }

    .calm-card {
      background-color: #1a1c23;
      border: 1px solid #272a34;
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.25);
    }

    @keyframes smoothFadeIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-calm {
      animation: smoothFadeIn 0.3s ease-out forwards;
    }

    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-thumb {
      background: #2e323e;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #3d4253;
    }

    .action-checkbox:checked + span {
      text-decoration: line-through;
      color: #64748b;
    }
  </style>
</head>
<body class="min-h-full flex flex-col font-sans bg-[#131418] text-slate-200">

  <!-- Barre supérieure sobre et aérée -->
  <header class="border-b border-[#232630] bg-[#16181e]/90 sticky top-0 z-20 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      
      <!-- Logo ReportFlow -->
      <div class="flex items-center space-x-3">
        <div class="w-8 h-8 rounded-lg bg-[#242833] border border-[#313645] flex items-center justify-center text-slate-100 font-heading font-semibold text-xs shadow-inner">
          RF
        </div>
        <div>
          <span class="font-heading font-bold text-sm text-slate-100">ReportFlow</span>
          <span class="text-slate-600 mx-1.5">•</span>
          <span class="text-xs text-slate-400">Carnet de réunion</span>
        </div>
      </div>

      <!-- Cloud Status Hub : Accès direct Google Drive & Notion -->
      <div class="flex items-center space-x-2 sm:space-x-2.5">
        
        <!-- Badge interactif Google Drive -->
        <a 
          href="<%= locals.driveUrl || '#' %>" 
          target="_blank" 
          rel="noopener noreferrer"
          class="group flex items-center space-x-2 text-xs bg-[#191b22] hover:bg-[#20232d] border border-[#262933] hover:border-[#383d4c] px-3 py-1.5 rounded-full transition-all duration-200 shadow-sm"
          title="Ouvrir le dossier des comptes-rendus dans Google Drive"
        >
          <!-- SVG officiel Google Drive -->
          <svg class="w-3.5 h-3.5 shrink-0 transition-transform duration-200 group-hover:scale-110" viewBox="0 0 87.3 78" xmlns="http://www.w3.org/2000/svg">
            <path d="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z" fill="#0066da"/>
            <path d="m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44c-.8 1.4-1.2 2.95-1.2 4.5h27.5z" fill="#00ac47"/>
            <path d="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.502l5.852 11.5z" fill="#ea4335"/>
            <path d="m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z" fill="#00832d"/>
            <path d="m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z" fill="#2684fc"/>
            <path d="m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3l-13.75 23.8 16.15 28h27.45c0-1.55-.4-3.1-1.2-4.5z" fill="#ffba00"/>
          </svg>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.7)] animate-pulse"></span>
          <span class="text-[12px] font-medium text-slate-300 group-hover:text-white transition-colors">Google Drive</span>
          <svg class="w-3 h-3 text-slate-500 group-hover:text-slate-300 transition-colors hidden sm:block" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="14" y1="14" y2="10"/>
          </svg>
        </a>

        <!-- Badge interactif Notion -->
        <a 
          href="<%= locals.notionUrl || '#' %>" 
          target="_blank" 
          rel="noopener noreferrer"
          class="group flex items-center space-x-2 text-xs bg-[#191b22] hover:bg-[#20232d] border border-[#262933] hover:border-[#383d4c] px-3 py-1.5 rounded-full transition-all duration-200 shadow-sm"
          title="Ouvrir la base de données Notion"
        >
          <!-- SVG officiel Notion -->
          <svg class="w-3.5 h-3.5 shrink-0 transition-transform duration-200 group-hover:scale-110" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6.015 13.513c3.424 2.71 4.544 2.56 10.822 2.128l58.987-4.256c2.428-.148 3.14-.852 2.28-2.71L73.978 2.378C72.552.41 70.418 0 67.57 0L10.005 3.968C6.301 4.248 5.161 5.39 5.73 7.828l.285 5.685z" fill="#ffffff"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M13.435 25.105v62.463c0 4.148 2.14 5.86 6.85 5.568l62.98-3.708c4.71-.282 5.28-3.284 5.28-6.998V20.106c0-3.714-1.57-5.286-4.99-4.998L18.425 18.96c-3.71.282-4.99 2.428-4.99 6.145zm58.557 3.568c.285 1.285-.43 2.57-1.854 2.71l-3.57.574v43.275c-2.14 1.144-4.566 1.855-6.85 1.855-3.71 0-5.14-1.285-7.994-4.714L34.56 42.667v26.99l5.14 1.143c1.425.286 1.854 1.57 1.425 2.856-.43 1.286-1.57 1.57-3.71 1.713l-11.42 1.002c-1.43.143-2.14-.716-1.712-2.144.285-1.286 1.14-2.144 2.567-2.429l3.996-.572V34.526l-4.71-.43c-1.427-.143-2-1.286-1.57-2.57.428-1.286 1.57-1.572 3.71-1.715l13.13-1.143 18.27 28.277V32.955l-4.28-.572c-1.427-.143-1.855-1.429-1.427-2.714.43-1.286 1.57-1.572 3.71-1.715l11.42-.714c1.712-.143 2.14.714 2.568 2.428z" fill="#ffffff"/>
          </svg>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.7)] animate-pulse"></span>
          <span class="text-[12px] font-medium text-slate-300 group-hover:text-white transition-colors">Notion</span>
          <svg class="w-3 h-3 text-slate-500 group-hover:text-slate-300 transition-colors hidden sm:block" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="14" y1="14" y2="10"/>
          </svg>
        </a>

      </div>

    </div>
  </header>

  <!-- Corps de page -->
  <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-8">
    
    <!-- En-tête : Ce que fait l'outil -->
    <div class="text-center max-w-2xl mx-auto mb-8">
      <h1 class="text-xl sm:text-2xl font-heading font-bold text-slate-100 tracking-tight">
        Rédigez vos notes, obtenez un résumé clair
      </h1>
      <p class="text-sm text-slate-400 mt-1.5 leading-relaxed">
        Collez vos notes ou déposez un audio. Nous extrayons le client, générons un rapport Word officiel et synchronisons la fiche en direct dans Notion et Google Drive.
      </p>

      <!-- Schéma visuel en 3 étapes avec vraies icônes vectorielles -->
      <div class="mt-5 inline-flex items-center justify-center gap-2 sm:gap-4 py-2 px-4 rounded-xl bg-[#191b22] border border-[#262933] text-xs text-slate-400 shadow-sm">
        
        <!-- Étape 1 -->
        <span class="flex items-center gap-1.5 text-slate-300 font-medium">
          <svg class="w-3.5 h-3.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
          </svg>
          Notes & Audio
        </span>

        <svg class="w-3.5 h-3.5 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>

        <!-- Étape 2 -->
        <span class="flex items-center gap-1.5 text-slate-300 font-medium">
          <svg class="w-3.5 h-3.5 text-sky-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
          </svg>
          Synthèse IA
        </span>

        <svg class="w-3.5 h-3.5 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>

        <!-- Étape 3 -->
        <span class="flex items-center gap-1.5 text-emerald-400 font-medium">
          <svg class="w-3.5 h-3.5 text-emerald-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/>
          </svg>
          Synchro Notion & Drive
        </span>

      </div>
    </div>

    <!-- Espace de travail en 2 colonnes -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- ============================================== -->
      <!-- PANNEAU GAUCHE : Saisie des notes (6 cols)     -->
      <!-- ============================================== -->
      <section class="lg:col-span-6 space-y-3">
        
        <div class="calm-card rounded-2xl overflow-hidden">
          
          <!-- Haut de l'éditeur avec vraies icônes vectorielles -->
          <div class="flex items-center justify-between px-5 py-3 border-b border-[#252834] bg-[#16181f]/60">
            <span class="text-xs font-semibold text-slate-300">Vos notes brutes</span>

            <!-- Boutons avec icônes appropriées -->
            <div class="flex items-center space-x-1.5 text-xs">
              
              <!-- Bouton Exemple -->
              <button 
                type="button" 
                id="btn-exemple"
                class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-lg text-slate-300 hover:text-white bg-[#222530] hover:bg-[#2b2e3c] border border-[#2e3240] transition-colors"
                title="Insérer un exemple de test"
              >
                <svg class="w-3.5 h-3.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>
                </svg>
                <span>Exemple</span>
              </button>

              <!-- Bouton Coller -->
              <button 
                type="button" 
                id="btn-paste"
                class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-lg text-slate-300 hover:text-white bg-[#222530] hover:bg-[#2b2e3c] border border-[#2e3240] transition-colors"
                title="Coller le texte de votre presse-papier"
              >
                <svg class="w-3.5 h-3.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/>
                </svg>
                <span>Coller</span>
              </button>

              <!-- Bouton Effacer -->
              <button 
                type="button" 
                id="btn-clear"
                class="inline-flex items-center space-x-1 px-2 py-1 rounded text-slate-400 hover:text-slate-200 transition-colors"
                title="Vider la zone de texte"
              >
                <svg class="w-3.5 h-3.5 text-slate-500 hover:text-slate-300" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/>
                </svg>
                <span>Effacer</span>
              </button>

            </div>
          </div>

          <!-- Zone de texte et dépôt de document -->
          <form id="form-analyse" class="p-5 space-y-4">
            <textarea 
              id="notes-brutes" 
              rows="10" 
              placeholder="Collez ou écrivez vos notes ici (ou déposez directement un document ci-dessous)...&#10;&#10;Exemple : Appel avec la direction de Ravinala Airports. Ils souhaitent une étude pour le terminal d'ici décembre..."
              class="w-full bg-transparent border-0 p-0 text-slate-100 placeholder-slate-500 focus:ring-0 focus:outline-none text-sm leading-relaxed resize-y font-sans"
            ></textarea>

            <!-- Zone de dépôt de document ou enregistrement audio (PDF, Word, MP3, M4A, etc.) -->
            <div class="space-y-2">
              <input 
                type="file" 
                id="input-fichier" 
                accept=".pdf,.docx,.txt,.mp3,.m4a,.wav,.ogg,.aac,.webm,.flac" 
                class="hidden"
              >

              <!-- Dropzone cliquable & glisser-déposer -->
              <div 
                id="dropzone"
                class="border border-dashed border-[#2d313e] hover:border-slate-500 bg-[#16181f]/40 hover:bg-[#1a1c24] rounded-xl p-3 text-center cursor-pointer transition-all flex items-center justify-between gap-3 group"
              >
                <div class="flex items-center space-x-2.5 text-xs text-slate-400">
                  <div class="w-7 h-7 rounded-lg bg-[#222530] flex items-center justify-center text-slate-300 shrink-0 group-hover:text-white transition-colors">
                    <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/>
                    </svg>
                  </div>
                  <div class="text-left">
                    <span class="font-medium text-slate-300 group-hover:text-white transition-colors">Joindre un document ou un enregistrement audio</span>
                    <span class="text-[11px] text-slate-500 block">PDF, Word (.docx), MP3, M4A, WAV (jusqu'à 2h / max 200 Mo)</span>
                  </div>
                </div>
                <span class="text-[11px] text-slate-400 bg-[#222530] border border-[#2e3240] px-2.5 py-1 rounded-md group-hover:text-white transition-colors shrink-0">
                  Parcourir
                </span>
              </div>

              <!-- Badge du fichier sélectionné -->
              <div id="file-chip" class="hidden items-center justify-between p-2.5 rounded-xl bg-[#1e212b] border border-[#2e3343] text-xs">
                <div class="flex items-center space-x-2 min-w-0">
                  <svg class="w-4 h-4 text-sky-400 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/>
                  </svg>
                  <div class="min-w-0">
                    <p id="file-name" class="text-slate-200 font-medium truncate"></p>
                    <p id="file-size" class="text-[10px] text-slate-400 font-mono"></p>
                  </div>
                </div>
                <button 
                  type="button" 
                  id="btn-remove-file"
                  class="text-slate-400 hover:text-rose-400 p-1 rounded hover:bg-[#282c3a] transition-colors"
                  title="Retirer ce document"
                >
                  <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Bas de l'éditeur -->
            <div class="pt-3 border-t border-[#252834] flex flex-col sm:flex-row items-center justify-between gap-3">
              
              <!-- Compteur de mots et caractères -->
              <div class="text-xs text-slate-400 flex items-center space-x-2">
                <span id="char-count">0 caractère</span>
                <span class="text-slate-600">•</span>
                <span id="word-count">0 mot</span>
              </div>

              <!-- Bouton d'action avec vraie icône de génération/envoi -->
              <button 
                type="submit" 
                id="btn-submit"
                class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 px-5 py-2.5 rounded-xl text-xs font-semibold text-slate-900 bg-slate-100 hover:bg-white active:scale-[0.99] transition-all disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer shadow-sm"
              >
                <!-- Spinner de chargement -->
                <svg id="spinner" class="hidden animate-spin -ml-0.5 mr-1.5 h-3.5 w-3.5 text-slate-900" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>

                <!-- Vraie icône Lucide Sparkles vectorielle -->
                <svg id="btn-icon" class="w-4 h-4 text-slate-900" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                  <path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/>
                </svg>

                <span id="btn-label">Créer la fiche Notion</span>
              </button>

            </div>
          </form>

        </div>

        <!-- Alerte en cas de problème -->
        <div id="error-box" class="hidden p-4 rounded-xl bg-rose-950/30 border border-rose-900/50 text-rose-200 text-xs">
          <div class="flex items-start space-x-2.5">
            <svg class="w-4 h-4 text-rose-400 shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/>
            </svg>
            <div>
              <p class="font-medium text-rose-200">Impossible de compléter l'opération</p>
              <p id="error-message" class="mt-1 text-rose-300/80 leading-relaxed"></p>
            </div>
          </div>
        </div>

      </section>

      <!-- ============================================== -->
      <!-- PANNEAU DROIT : Compte-rendu généré (6 cols)   -->
      <!-- ============================================== -->
      <section class="lg:col-span-6 space-y-3">
        
        <!-- ÉTAT 1 : En attente avec icône de carnet vectorielle -->
        <div id="result-placeholder" class="calm-card rounded-2xl p-8 text-center flex flex-col items-center justify-center min-h-[400px] border-dashed border-[#2d313e]">
          <div class="w-12 h-12 rounded-xl bg-[#21242e] border border-[#2b2f3d] flex items-center justify-center text-slate-400 mb-3 shadow-inner">
            <svg class="w-6 h-6 text-slate-300" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 6h4"/><path d="M2 10h4"/><path d="M2 14h4"/><path d="M2 18h4"/><rect width="16" height="20" x="4" y="2" rx="2"/><path d="M16 2v20"/><path d="M9 7h3"/><path d="M9 11h4"/><path d="M9 15h2"/>
            </svg>
          </div>
          <h3 class="font-heading font-semibold text-sm text-slate-200">Votre fiche apparaîtra ici</h3>
          <p class="text-xs text-slate-400 max-w-xs mt-1.5 leading-relaxed">
            Dès que vous validez vos notes, nous extrayons le client, rédigeons la synthèse et ajoutons la ligne dans votre tableau Notion.
          </p>

          <button 
            type="button" 
            id="btn-placeholder-demo"
            class="mt-5 inline-flex items-center space-x-1.5 text-xs text-slate-300 hover:text-white bg-[#222530] hover:bg-[#2b2f3c] border border-[#2f3342] px-3.5 py-1.5 rounded-lg transition-colors shadow-sm"
          >
            <svg class="w-3.5 h-3.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
            <span>Tester avec un exemple</span>
          </button>
        </div>

        <!-- ÉTAT 2 : En cours de résumé -->
        <div id="result-skeleton" class="hidden calm-card rounded-2xl p-6 space-y-5">
          <div class="flex items-center space-x-2 text-xs text-slate-300 pb-3 border-b border-[#252834]">
            <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
            <span>Préparation de votre compte-rendu...</span>
          </div>

          <div class="space-y-4 animate-pulse">
            <div>
              <div class="h-2.5 w-16 bg-[#252834] rounded mb-1.5"></div>
              <div class="h-5 w-44 bg-[#2b2e3c] rounded"></div>
            </div>
            <div>
              <div class="h-2.5 w-20 bg-[#252834] rounded mb-1.5"></div>
              <div class="h-14 w-full bg-[#222530] rounded-xl"></div>
            </div>
            <div>
              <div class="h-2.5 w-24 bg-[#252834] rounded mb-1.5"></div>
              <div class="h-10 w-full bg-[#222530] rounded-xl mb-1.5"></div>
              <div class="h-10 w-full bg-[#222530] rounded-xl"></div>
            </div>
          </div>
        </div>

        <!-- ÉTAT 3 : Fiche terminée et enregistrée -->
        <div id="result-content" class="hidden space-y-3 animate-calm">
          
              <!-- Bandeau de confirmation Cloud double (Notion & Drive) -->
            <div class="px-5 py-3 border-b border-[#252834] bg-[#16181f]/80 flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center space-x-2.5">
                <div class="w-6 h-6 rounded-full bg-emerald-950/80 border border-emerald-500/30 flex items-center justify-center shrink-0 shadow-sm">
                  <svg class="w-3.5 h-3.5 text-emerald-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5"/>
                  </svg>
                </div>
                <div>
                  <span class="text-xs font-semibold text-slate-100 flex items-center gap-1.5">
                    Synchronisé avec succès
                    <span class="text-[10px] text-emerald-300 bg-emerald-950/60 border border-emerald-800/50 px-2 py-0.5 rounded-full font-medium">Notion + Drive</span>
                  </span>
                </div>
              </div>

              <!-- ID Notion & Bouton Copier -->
              <div class="flex items-center space-x-1.5 text-xs text-slate-400">
                <span class="text-[11px] font-mono truncate max-w-[130px]" id="notion-page-id"></span>
                <button 
                  type="button" 
                  id="btn-copy-id" 
                  class="inline-flex items-center space-x-1 px-2 py-0.5 rounded bg-[#252834] hover:bg-[#2f3342] text-[11px] text-slate-300 hover:text-white transition-colors"
                  title="Copier l'identifiant de la page Notion"
                >
                  <svg class="w-3 h-3 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                  </svg>
                  <span id="copy-label">Copier</span>
                </button>
              </div>
            </div>

            <!-- Contenu structuré -->
            <div class="p-5 space-y-5">
              
              <!-- Client -->
              <div>
                <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Client / Entreprise</span>
                <h2 id="res-client" class="text-lg font-heading font-bold text-slate-100 mt-0.5"></h2>
              </div>

              <!-- Synthèse concise -->
              <div>
                <div class="flex items-center justify-between mb-1">
                  <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Résumé en 2 phrases</span>
                  
                  <button type="button" id="btn-copy-synthese" class="inline-flex items-center space-x-1 text-[11px] text-slate-400 hover:text-slate-200 transition-colors">
                    <svg class="w-3 h-3 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                    </svg>
                    <span>Copier</span>
                  </button>
                </div>
                <div class="p-3.5 rounded-xl bg-[#15171e] border border-[#252834]">
                  <p id="res-synthese" class="text-xs sm:text-sm text-slate-200 leading-relaxed"></p>
                </div>
              </div>

              <!-- Actions à faire (Checklist claire) -->
              <div>
                <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Choses à faire</span>
                <div id="actions-checklist" class="mt-2 space-y-2">
                  <!-- Rempli dynamiquement par app.js -->
                </div>
                <p id="res-actions" class="hidden text-xs text-slate-300"></p>
              </div>

            </div>

            <!-- Détail technique replié discrètement -->
            <div class="px-5 py-2.5 border-t border-[#252834] bg-[#14161c]/40">
              <details class="text-[11px] text-slate-400 cursor-pointer">
                <summary class="hover:text-slate-300 select-none">Voir les données techniques (JSON)</summary>
                <pre id="res-json" class="mt-2 p-3 rounded-lg bg-[#0e1014] border border-[#232630] font-mono text-[10.5px] text-slate-400 overflow-x-auto"></pre>
              </details>
            </div>

          </div>

          <!-- Carte d'Action : Export Word, Google Docs & Notion -->
          <div class="calm-card rounded-2xl p-4 sm:p-5 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 border border-[#2d303b] bg-gradient-to-r from-[#171922] via-[#1a1c26] to-[#1e1b24]">
            <div class="flex items-center space-x-3.5">
              <div class="w-10 h-10 rounded-xl bg-[#232634] border border-[#34384a] flex items-center justify-center text-slate-200 shrink-0 shadow-inner">
                <svg class="w-5 h-5 text-sky-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 13v-2"/><path d="M14 13v-2"/><path d="M10 17v-2"/><path d="M14 17v-2"/>
                </svg>
              </div>
              <div>
                <h4 class="text-xs sm:text-sm font-heading font-semibold text-slate-100 flex items-center gap-2">
                  Livrables & Accès Cloud
                  <span class="text-[10px] font-normal uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#202534] text-sky-300 border border-[#2d354d]">Synchronisé</span>
                </h4>
                <p class="text-[11px] text-slate-400 mt-0.5">Ouvrez directement dans Notion, éditez dans Google Docs ou téléchargez le Word</p>
              </div>
            </div>

            <!-- Trio de boutons d'action avec logos officiels -->
            <div class="flex flex-wrap items-center gap-2 w-full lg:w-auto">
              
              <!-- 1. Bouton Ouvrir sur Notion -->
              <a 
                id="link-notion-action"
                href="#"
                target="_blank" 
                rel="noopener noreferrer"
                class="hidden flex-1 sm:flex-none inline-flex items-center justify-center space-x-2 px-3 py-2 rounded-xl text-xs font-medium text-slate-200 hover:text-white bg-[#222532] hover:bg-[#2b2f3f] border border-[#313647] hover:border-slate-400 transition-all shadow-sm group active:scale-[0.98]"
                title="Ouvrir la fiche directement dans Notion"
              >
                <!-- Mini SVG Notion -->
                <svg class="w-3.5 h-3.5 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6.015 13.513c3.424 2.71 4.544 2.56 10.822 2.128l58.987-4.256c2.428-.148 3.14-.852 2.28-2.71L73.978 2.378C72.552.41 70.418 0 67.57 0L10.005 3.968C6.301 4.248 5.161 5.39 5.73 7.828l.285 5.685z" fill="#ffffff"/>
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M13.435 25.105v62.463c0 4.148 2.14 5.86 6.85 5.568l62.98-3.708c4.71-.282 5.28-3.284 5.28-6.998V20.106c0-3.714-1.57-5.286-4.99-4.998L18.425 18.96c-3.71.282-4.99 2.428-4.99 6.145zm58.557 3.568c.285 1.285-.43 2.57-1.854 2.71l-3.57.574v43.275c-2.14 1.144-4.566 1.855-6.85 1.855-3.71 0-5.14-1.285-7.994-4.714L34.56 42.667v26.99l5.14 1.143c1.425.286 1.854 1.57 1.425 2.856-.43 1.286-1.57 1.57-3.71 1.713l-11.42 1.002c-1.43.143-2.14-.716-1.712-2.144.285-1.286 1.14-2.144 2.567-2.429l3.996-.572V34.526l-4.71-.43c-1.427-.143-2-1.286-1.57-2.57.428-1.286 1.57-1.572 3.71-1.715l13.13-1.143 18.27 28.277V32.955l-4.28-.572c-1.427-.143-1.855-1.429-1.427-2.714.43-1.286 1.57-1.572 3.71-1.715l11.42-.714c1.712-.143 2.14.714 2.568 2.428z" fill="#ffffff"/>
                </svg>
                <span>Fiche Notion</span>
              </a>

              <!-- 2. Bouton Ouvrir dans Google Docs (éditable en ligne) -->
              <a 
                id="link-google-docs"
                href="#"
                target="_blank" 
                rel="noopener noreferrer"
                class="hidden flex-1 sm:flex-none inline-flex items-center justify-center space-x-2 px-3 py-2 rounded-xl text-xs font-medium text-sky-200 bg-[#15233c] hover:bg-[#1c2e4e] border border-[#253e6c] hover:border-sky-400 transition-all shadow-sm group active:scale-[0.98]"
                title="Ouvrir le compte-rendu dans Google Docs"
              >
                <!-- Mini SVG Google Docs -->
                <svg class="w-3.5 h-3.5 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 87.3 78" xmlns="http://www.w3.org/2000/svg">
                  <path d="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z" fill="#0066da"/>
                  <path d="m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44c-.8 1.4-1.2 2.95-1.2 4.5h27.5z" fill="#00ac47"/>
                  <path d="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.502l5.852 11.5z" fill="#ea4335"/>
                  <path d="m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z" fill="#00832d"/>
                  <path d="m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z" fill="#2684fc"/>
                  <path d="m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3l-13.75 23.8 16.15 28h27.45c0-1.55-.4-3.1-1.2-4.5z" fill="#ffba00"/>
                </svg>
                <span>Google Docs</span>
              </a>

              <!-- 3. Bouton Téléchargement Direct .docx -->
              <button 
                type="button" 
                id="btn-telecharger-word"
                class="flex-1 sm:flex-none inline-flex items-center justify-center space-x-2 px-3 py-2 rounded-xl text-xs font-medium text-slate-100 bg-[#34222c] hover:bg-[#442b3a] border border-[#543343] hover:border-[#C97A7E] transition-all shadow-sm group active:scale-[0.98]"
                title="Télécharger le document Word (.docx) sur votre ordinateur"
              >
                <svg id="icon-telecharger-word" class="w-3.5 h-3.5 text-[#C97A7E] group-hover:translate-y-0.5 transition-transform" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>
                </svg>
                <svg id="spinner-word" class="hidden animate-spin w-3.5 h-3.5 text-[#C97A7E]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                </svg>
                <span id="btn-telecharger-word-label">Word (.docx)</span>
              </button>

            </div>
          </div>

        </div>

      </section>

    </div>
  </main>

  <!-- Pied de page -->
  <footer class="border-t border-[#20222a] py-4 bg-[#131418] text-center text-xs text-slate-400">
    <p>ReportFlow • Vos réunions résumées et rangées dans Notion</p>
  </footer>

  <script src="/js/app.js"></script>
</body>
</html>
